# Пример конфигурации окружения.
# Скопируйте в .env и заполните собственными значениями:
#   cp .env.example .env
# ВАЖНО: .env содержит секреты и не хранится в git (см. .gitignore).

# --- common ---
# Окружение: loc | prod (выбирает docker-compose.nginx.{loc|prod}.yml)
PROJECT_ENVIRONMENT=loc
PROJECT_URL_SCHEME=http
PROJECT_DOMAIN=universal-bot-constructor.loc
# Каталог данных на хосте (БД, redis, rabbitmq, pdf) — монтируется в контейнеры
PROJECT_DATA_DIR=/data/universal-bot-constructor

# --- certbot (prod) ---
# Каталоги: conf — сертификаты (/etc/letsencrypt), www — webroot HTTP-01
CERTBOT_DATA_DIR="${PROJECT_DATA_DIR}/certbot"
# E-mail для регистрации ACME-аккаунта Let's Encrypt (уведомления об истечении)
CERTBOT_EMAIL=change_me

# --- rabbitmq ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_USERNAME=guest
# Сгенерируйте: openssl rand -hex 32
RABBITMQ_PASSWORD=change_me
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_VHOST=/
RABBITMQ_DATA_DIR="${PROJECT_DATA_DIR}/rabbitmq"

# --- redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
#REDIS_USERNAME=default
REDIS_PASSWORD=change_me
REDIS_DATA_DIR="${PROJECT_DATA_DIR}/redis"

# --- postgres (через pgbouncer) ---
POSTGRES_HOST=pgbouncer
POSTGRES_PORT=5432
POSTGRES_DATA_DIR="${PROJECT_DATA_DIR}/db"
POSTGRES_BACKUPS_DIR="${PROJECT_DATA_DIR}/backups"

POSTGRES_DB=universal_bot_constructor
POSTGRES_USER=universal_bot_constructor
POSTGRES_PASSWORD=change_me

# Отдельная БД для интеграционных тестов (шаг 7)
POSTGRES_TEST_DB=universal_bot_constructor_test
POSTGRES_TEST_USER=universal_bot_constructor_test
POSTGRES_TEST_PASSWORD=change_me

# --- sqlalchemy ---
# SQLALCHEMY_DEBUG=True — печатает все SQL-запросы в лог (только для разработки!)
SQLALCHEMY_DEBUG=False
SQLALCHEMY_POOL_SIZE=50
SQLALCHEMY_MAX_OVERFLOW=-1
SQLALCHEMY_POOL_RECYCLE=600
SQLALCHEMY_POOL_USE_LIFO=False
SQLALCHEMY_POOL_PRE_PING=True

# --- CORS (JSON-список origins frontend) ---
# Админка и API — на одном домене через nginx; для npm run dev добавьте
# "http://localhost:3000"
CORS_ORIGINS=["${PROJECT_URL_SCHEME}://${PROJECT_DOMAIN}"]

# --- backend ---
BACKEND_DEBUG=True
BACKEND_WORKER_COUNT=2
BACKEND_CONTAINER_COMMAND="--workers ${BACKEND_WORKER_COUNT}"
# Для разработки можно: BACKEND_CONTAINER_COMMAND="--reload"
BACKEND_PORT=8000
BACKEND_API_PREFIX=/api/v1
BACKEND_BASE_URL="${PROJECT_URL_SCHEME}://${PROJECT_DOMAIN}"
# Каталог хранения PDF-файлов (монтируется в backend и bot)
BACKEND_PDF_DATA_DIR="${PROJECT_DATA_DIR}/pdf"

# --- consumer (очереди и routing keys уведомлений) ---
# Routing keys издателя должны совпадать с привязкой очередей!
CONSUMER_QUEUE_REGISTRATION=bot.notify.registration
CONSUMER_QUEUE_REQUEST_CREATED=bot.notify.request.created
CONSUMER_QUEUE_REQUEST_CANCELLED=bot.notify.request.cancelled
CONSUMER_QUEUE_REQUEST_STATUS=bot.notify.request.status
CONSUMER_ROUTING_REGISTRATION=bot.notify.registration
CONSUMER_ROUTING_REQUEST_CREATED=bot.notify.request.created
CONSUMER_ROUTING_REQUEST_CANCELLED=bot.notify.request.cancelled
CONSUMER_ROUTING_REQUEST_STATUS=bot.notify.request.status

# --- bot (aiogram) ---
# Токен от @BotFather
BOT_TOKEN=1234567890:AAAA-your-bot-token-here
# Прокси для Telegram API (необязательно), напр. socks5://user:pass@host:port
#BOT_PROXY_URL=
# Webhook (prod). Пустой BOT_WEBHOOK_BASE_URL — long-polling (loc).
# В prod: BOT_WEBHOOK_BASE_URL="${PROJECT_URL_SCHEME}://${PROJECT_DOMAIN}"
BOT_WEBHOOK_BASE_URL=
# Путь webhook (nginx проксирует /bot/ -> bot:8080)
BOT_WEBHOOK_PATH=/bot/webhook
# Секрет X-Telegram-Bot-Api-Secret-Token: Telegram передаёт его в каждом апдейте,
# бот отклоняет запросы без него (401). Обязателен в prod при заданном
# BOT_WEBHOOK_BASE_URL. Формат: 1–256 символов A-Z a-z 0-9 _ -
# Сгенерируйте: openssl rand -hex 32   (base64 НЕ подходит: + / =)
BOT_WEBHOOK_SECRET=
# Адрес/порт aiohttp-приложения webhook внутри контейнера bot
BOT_WEBHOOK_HOST=0.0.0.0
BOT_WEBHOOK_PORT=8080

# --- backend jwt ---
# ОБЯЗАТЕЛЬНО: без секрета приложение не запустится (fail-fast).
# Сгенерируйте: openssl rand -base64 64 | tr -d '\n' (в prod >= 32 байт)
BACKEND_JWT_SECRET=change_me
