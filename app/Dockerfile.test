# Тестовый образ: prod-зависимости + dev-зависимости (pytest и т.д.) + тесты.
# Используется сервисом test-runner (docker-compose.test.yml).
# Контекст сборки — КОРЕНЬ проекта (uv.lock лежит в корне workspace):
#   docker build -t ubc-app-test:latest -f app/Dockerfile.test .
FROM python:3.13-slim

# закреплённая версия uv (совпадает с форматом uv.lock)
COPY --from=ghcr.io/astral-sh/uv:0.7.19 /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/app/.venv

WORKDIR /workspace
# зависимости строго по uv.lock (--locked: сборка падает, если lock
# рассинхронизирован с pyproject.toml), включая dev-группу ubc-app
# (без `|| true`: любая ошибка установки валит сборку)
COPY pyproject.toml uv.lock ./
COPY app/pyproject.toml ./app/
RUN uv sync --locked --package ubc-app --no-install-workspace
COPY app/src/ ./app/src/
RUN uv sync --locked --package ubc-app --no-editable

WORKDIR /app
COPY app/pyproject.toml ./
COPY app/src/ ./src/
COPY app/tests/ ./tests/
COPY app/alembic.ini ./
COPY app/alembic/ ./alembic/

# Активируем venv
ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1

# По умолчанию — ожидание (тесты запускаются через docker exec)
CMD ["/bin/sh", "-c", "tail -f /dev/null"]
